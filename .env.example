# Smriti Saathi Environment Configuration Example
DATABASE_URL=postgres://postgres@localhost:5433/elder_db
PORT=5000
NODE_ENV=production

# Security Secrets (Generate using crypto.randomBytes(32).toString('hex'))
JWT_SECRET=your_jwt_secret_here_64_characters
ENCRYPTION_KEY=your_encryption_key_here_64_hex_characters
CRON_SECRET=your_cron_secret_here

# Web Push Notification VAPID Keys (Generate using web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@smritisaathi.in

# Mode & Fallbacks
DEMO_MODE=false

# Twilio Configuration (Optional - provides real SMS & Voice calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Optional Gemini AI API Key
GEMINI_API_KEY=
