# ====================================================================
# Smriti Saathi — Production & Development Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (Render automatically sets PORT)
# --------------------------------------------------------------------
PORT=5000
NODE_ENV=production
PUBLIC_BASE_URL=https://your-service-name.onrender.com

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED for Production)
# --------------------------------------------------------------------
# For Render PostgreSQL: copy the "Internal Database URL" from your Render PostgreSQL instance.
# Example: postgresql://elder_user:password@dpg-xxx-a.oregon-postgres.render.com/elder_db
# If left empty, Smriti Saathi will safely fall back to local SQLite (server/data/elder.db).
DATABASE_URL=postgresql://elder_user:password@dpg-xxx-a.oregon-postgres.render.com/elder_db

# --------------------------------------------------------------------
# 3. SECURITY & ENCRYPTION SECRETS (REQUIRED for Production)
# --------------------------------------------------------------------
# Generate using Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_64_char_random_hex_string
ENCRYPTION_KEY=replace_with_a_secure_64_char_random_hex_string
CRON_SECRET=replace_with_a_secure_random_string_for_cron_tick

# --------------------------------------------------------------------
# 4. WEB PUSH NOTIFICATIONS (OPTIONAL - VAPID Keys)
# --------------------------------------------------------------------
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@smritisaathi.in

# --------------------------------------------------------------------
# 5. TWILIO SMS & VOICE (OPTIONAL - provides real emergency calls & SMS)
# --------------------------------------------------------------------
# If not provided, Smriti Saathi automatically runs in simulated safe mode.
DEMO_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# --------------------------------------------------------------------
# 6. GOOGLE GEMINI AI (OPTIONAL - enhances cognitive summaries)
# --------------------------------------------------------------------
GEMINI_API_KEY=
