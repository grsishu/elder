{
  "name": "smriti-saathi",
  "version": "1.0.0",
  "description": "AI-Based Cognitive Gaming and Memory Assistance Platform for Elderly Dementia Patients in North Eastern India",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <=22.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "build": "node scripts/build.js",
    "render-build": "node scripts/build.js",
    "build:client": "npm --prefix client run build",
    "install:client": "npm --prefix client install",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "check:i18n": "node scripts/check-i18n.js",
    "test:db": "node scripts/test_pg_connection.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.18",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "twilio": "^5.4.3",
    "vite": "^6.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
